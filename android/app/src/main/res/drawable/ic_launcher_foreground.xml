<!-- TacMap launcher foreground: crosshair reticle + red north triangle + green
     viewfinder corners, matching the iOS app icon. Adaptive viewport is 108x108;
     the reticle stays inside the safe zone so the launcher mask doesn't clip it,
     and the corner brackets sit just inside the edges like the iOS art. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Green viewfinder corner brackets (top-left, top-right, bottom-left, bottom-right) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#8CF28C"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,26 L26,26 L26,37 M71,26 L82,26 L82,37 M37,82 L26,82 L26,71 M71,82 L82,82 L82,71" />

    <!-- Red north-pointing triangle above the ring -->
    <path
        android:fillColor="#F24C3D"
        android:pathData="M54,27 L47.5,41 L60.5,41 Z" />

    <!-- Orange crosshair: cross arms (centre 54,62) -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M54,41 L54,85 M31,62 L77,62" />
    <!-- ring -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFB020"
        android:strokeWidth="3.6"
        android:pathData="M54,62 m-15,0 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0" />
    <!-- centre dot -->
    <path
        android:fillColor="#FFB020"
        android:pathData="M54,62 m-3.6,0 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
</vector>
