{
  "schemaVersion": 1,
  "description": "Shared external-import identity contract. Waypoint and drawing IDs occupy one global object namespace. Layer IDs are a separate namespace and layer records/references are never reminted by this resolver.",
  "contract": {
    "objectKinds": ["waypoint", "drawing"],
    "comparison": "Parse IDs as UUID values; fixture spelling is lowercase and string case is not identity.",
    "resolutionOrder": "Process incomingObjects in array order. Preserve the first valid UUID not already used by an existing or earlier incoming waypoint/drawing. Otherwise consume the next injectedRemintIds value.",
    "layerRule": "Do not add layer IDs to the object-ID occupied set. Do not rewrite layer records or any object's layerId.",
    "retryRule": "A retry of the same batch reuses its prior caseKey-to-resolvedId map before collision checks. Applying those resolved objects is an idempotent upsert/skip, never a second import.",
    "caseKeyRule": "caseKey is stable test/batch metadata, not an application object ID or layer ID."
  },
