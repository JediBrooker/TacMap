{
  // TacMap real-time sync backend (Cloudflare Worker + Durable Object).
  // Self-hostable: a unit can deploy this to their own Cloudflare account.
  "name": "tacmap-sync",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // Observability is OFF: request logs would capture the /room/<id> path, and
  // the room id is the sole routing credential for an "E2E-blind" relay, so
  // logging it would hand infrastructure operators a capability to the room.
  // Self-hosters MUST keep this disabled (or scrub the path) for the same
  // reason. See sync/README.md.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "SYNC_ROOM", "class_name": "SyncRoom" }
    ]
  },
  // SQLite-backed Durable Objects — available on the Workers free plan and the
  // current recommended storage backend.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }
  ],
  // Per-IP rate limiting for connection and room-creation abuse control.
  // Eventually consistent (not exact accounting); durable per-room quotas
  // are the primary defense. Self-hosters can adjust or remove these.
  "ratelimits": [
    {
      "name": "CONN_LIMITER",
      "namespace_id": "1001",
      "simple": { "period": 60, "limit": 60 }
    },
    {
      "name": "ROOM_LIMITER",
      "namespace_id": "1002",
      "simple": { "period": 60, "limit": 10 }
    }
  ]
}
