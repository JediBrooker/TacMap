{
  "name": "tacmap-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TacMap real-time sync backend — E2E-blind relay on Cloudflare Durable Objects",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types worker-configuration.d.ts --include-runtime=false --check && tsc --noEmit",
    "check": "wrangler deploy --dry-run",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "5.20260712.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
